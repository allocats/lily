fprintf :: foreign fn(file: *void, fmt: *u8, args: ...) -> i32;
vprintf :: foreign fn(fmt: *u8, ap: va_list) -> i32;
printf  :: foreign fn(fmt: *u8, args: ...) -> i32;

putchar :: foreign fn(c: i32) -> i32;

fopen  :: foreign fn(path: *u8, mode: *u8) -> *void;
fclose :: foreign fn(file: *void) -> i32;
fread  :: foreign fn(buffer: *void, buffer_element_size: isize, number_of_elements: isize, file: *void) -> isize;
fwrite :: foreign fn(buffer: *void, buffer_element_size: isize, number_of_elements: isize, file: *void) -> isize;
