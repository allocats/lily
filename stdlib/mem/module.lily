calloc  :: external fn(size: usize) -> *void;
malloc  :: external fn(size: usize) -> *void;
realloc :: external fn(ptr: *void, size: isize) -> *void;

free :: external fn(ptr: *void);

memset  :: intrinsic fn(dest: *void, byte: i8,  size: isize);
memcopy :: intrinsic fn(dest: *void, src: *void, size: isize);
memmove :: intrinsic fn(dest: *void, src: *void, size: isize);
